/settings/
flash-editor.log
*.flash.recovery
recovery.flash

# ---- Temporary / scratch files ----
/temp/
*.tmp
*.bak
*.orig
*.log

# ---- Installer build output (Phase 16) ----
/installer/build/
/installer/output/
*.msi

# ---- .NET helper build output ----
/tools/csharp-fixtures/bin/
/tools/csharp-fixtures/obj/

# ---- Python caches (scripts\convert_icons.py) ----
__pycache__/
*.pyc

# ---- Editors / OS ----
.vs/
.vscode/
.idea/
*.swp
*~
Thumbs.db
desktop.ini
