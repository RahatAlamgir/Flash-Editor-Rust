# ---- Rust build output ----
/target/
**/*.rs.bk
*.pdb

# ---- AI runtime and models (large; downloaded or copied by scripts\get-ai-runtime.ps1) ----
/models/
*.onnx
*.onnx.data
onnxruntime*.dll
DirectML.dll

